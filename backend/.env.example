# Server
PORT=5000
NODE_ENV=development

# Auth — REQUIRED in production (>= 32 chars). Server refuses to boot without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secret_jwt_key_here_at_least_32_chars_long

# Database
DB_PATH=./data/subscrr.db

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
# Comma-separated allowlist for production browsers, e.g. https://app.subscrr.com,https://subscrr.com
CORS_ORIGINS=http://localhost:3000

# Admin bootstrap password (first run only — change after first login!)
ADMIN_PASSWORD=

# Uploads
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# Email delivery (password resets, welcome, alerts)
# Resolution order: RESEND_API_KEY > SMTP_HOST+SMTP_USER > Ethereal (dev only)
# > JSON logger (offline). Production MUST set Resend or SMTP or emails are
# only logged — the server prints a loud warning and /api/health reports it.
# ---------------------------------------------------------------------------

# Option 1 (recommended): Resend HTTP API — https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Verified sender, e.g. "Subscrr <alerts@yourdomain.com>".
# Without a custom domain you may only send to your own account email.
# EMAIL_FROM=Subscrr <alerts@yourdomain.com>

# Option 2: any SMTP provider (Gmail app-password, Postmark, SES, Mailgun…)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your_app_password
